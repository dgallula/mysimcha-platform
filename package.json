{
  "name": "mysimcha-platform",
  "private": true,
  "version": "0.0.0",
  "description": "MySimcha — premium multi-brand SaaS for digital emotional invitations",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml,css}\"",
    "db:generate": "turbo run db:generate --filter=@mysimcha/database",
    "db:migrate": "turbo run db:migrate --filter=@mysimcha/database",
    "db:deploy": "turbo run db:deploy --filter=@mysimcha/database",
    "db:studio": "turbo run db:studio --filter=@mysimcha/database",
    "db:validate": "turbo run db:validate --filter=@mysimcha/database",
    "db:seed": "pnpm --filter @mysimcha/database db:seed",
    "clean": "turbo run clean && rimraf node_modules",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@mysimcha/config": "workspace:*",
    "@mysimcha/tsconfig": "workspace:*",
    "@next/eslint-plugin-next": "15.5.21",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
