# =============================================================================
# MySimcha Platform — Environment Template
# Copy to repository root as `.env` for local development.
# App-specific overrides: `apps/<app>/.env.local` (never commit).
# Also see: /env/*.example for environment-specific templates.
# =============================================================================

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# Apps
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
LANDING_URL=http://localhost:3002
DOCS_URL=http://localhost:3003

# Database (PostgreSQL)
DATABASE_URL=postgresql://mysimcha:mysimcha@localhost:5432/mysimcha?schema=public
DATABASE_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=mysimcha:

# Auth.js
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mysimcha

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@mysimcha.com

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Google Maps
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# AI (OpenAI)
OPENAI_API_KEY=
AI_DEFAULT_PROVIDER=openai

# Monitoring (Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Multi-brand defaults
DEFAULT_BRAND=mybatmitzvah
DEFAULT_LOCALE=en
DEFAULT_THEME=luxury-gold

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
